root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,xaml,csproj,xml,html,css,js,ts,tsx,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 needs a BOM when the script contains Japanese text
[*.ps1]
charset = utf-8-bom
