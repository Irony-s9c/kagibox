<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KagiBox.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="RowGrid" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="20" />
            <Setter Property="Padding" Value="0,10" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="860" Padding="28,20,28,28" HorizontalAlignment="Left" Spacing="4">
            <TextBlock Style="{StaticResource PageTitle}" Text="設定" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="セキュリティ" />
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="自動ロック" />
                            <TextBlock Style="{StaticResource Caption}" Text="PC を操作しない時間がこれを超えるとロックします。Win+L やスリープでは常にすぐロックします。" />
                        </StackPanel>
                        <ComboBox x:Name="IdleLockBox" Grid.Column="1" Width="140" VerticalAlignment="Center" SelectionChanged="IdleLockBox_SelectionChanged">
                            <ComboBoxItem Content="しない" Tag="0" />
                            <ComboBoxItem Content="1 分" Tag="1" />
                            <ComboBoxItem Content="5 分" Tag="5" />
                            <ComboBoxItem Content="15 分" Tag="15" />
                            <ComboBoxItem Content="30 分" Tag="30" />
                            <ComboBoxItem Content="60 分" Tag="60" />
                        </ComboBox>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="クリップボードの自動消去" />
                            <TextBlock x:Name="ClipboardText" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <FontIcon Grid.Column="1" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="オートタイプ（自動入力）" />
            <Border Style="{StaticResource FluentCard}">
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="使い方" />
                        <TextBlock x:Name="AutotypeText" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <Border
                        x:Name="AutotypeStatus"
                        Grid.Column="1"
                        Padding="10,3"
                        VerticalAlignment="Center"
                        CornerRadius="10">
                        <TextBlock x:Name="AutotypeStatusText" FontSize="12" />
                    </Border>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="バックアップ" />
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="エクスポート" />
                            <TextBlock Style="{StaticResource Caption}" Text="暗号化されたままのバックアップファイルを書き出します。" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Click="Export_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE896;" />
                                <TextBlock Text="エクスポート" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="インポート" />
                            <TextBlock Style="{StaticResource Caption}" Text="バックアップファイルから復元します（今の保管庫は置き換えられます）。" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Click="Import_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE898;" />
                                <TextBlock Text="インポート" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="保存場所" />
                            <TextBlock x:Name="DataDirText" FontFamily="{StaticResource KagiMonoFont}" IsTextSelectionEnabled="True" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Click="OpenData_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE838;" />
                                <TextBlock Text="フォルダを開く" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="アップデート" />
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="起動時に確認する" />
                            <TextBlock Style="{StaticResource Caption}" Text="新しいバージョンがあると、アップデートするかどうかを確認します。" />
                        </StackPanel>
                        <ToggleSwitch x:Name="UpdateToggle" Grid.Column="1" MinWidth="0" VerticalAlignment="Center" OffContent="" OnContent="" Toggled="UpdateToggle_Toggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="バージョン" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <Button x:Name="CheckUpdateButton" Grid.Column="1" VerticalAlignment="Center" Click="CheckUpdate_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE895;" />
                                <TextBlock x:Name="CheckUpdateText" Text="今すぐ確認" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="キーボードショートカット" />
            <Border Style="{StaticResource FluentCard}">
                <Grid ColumnSpacing="24" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock FontFamily="{StaticResource KagiMonoFont}" Text="Ctrl+F" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="検索" />
                    <TextBlock Grid.Row="1" FontFamily="{StaticResource KagiMonoFont}" Text="Ctrl+N" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Caption}" Text="アカウントを追加" />
                    <TextBlock Grid.Row="2" FontFamily="{StaticResource KagiMonoFont}" Text="Ctrl+L" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Caption}" Text="今すぐロック" />
                    <TextBlock Grid.Row="3" FontFamily="{StaticResource KagiMonoFont}" Text="Enter" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Caption}" Text="（一覧・検索中）選択中のパスワードをコピー" />
                    <TextBlock Grid.Row="4" FontFamily="{StaticResource KagiMonoFont}" Text="Shift+Enter" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Caption}" Text="（一覧・検索中）選択中の ID をコピー" />
                    <TextBlock Grid.Row="5" FontFamily="{StaticResource KagiMonoFont}" Text="F2" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Caption}" Text="（一覧）選択中のアカウントを編集" />
                    <TextBlock x:Name="HotkeyShortcut" Grid.Row="6" FontFamily="{StaticResource KagiMonoFont}" Text="Ctrl+Alt+V" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Caption}" Text="（どのアプリでも）オートタイプ" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
