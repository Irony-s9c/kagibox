<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="KagiBox.Features.Settings.ImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="バックアップからインポート"
    CloseButtonText="キャンセル"
    DefaultButton="Primary"
    PrimaryButtonClick="Import_Click"
    PrimaryButtonText="インポート"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel MinWidth="440" Spacing="12">
        <InfoBar IsClosable="False" IsOpen="True" Message="今の保管庫は、選んだバックアップの内容に置き換えられます。" Severity="Warning" />
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Click="Choose_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE838;" />
                    <TextBlock Text="ファイルを選択" />
                </StackPanel>
            </Button>
            <TextBlock
                x:Name="FileText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource Caption}"
                Text="未選択"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Grid>
        <PasswordBox x:Name="PasswordBox" Header="バックアップ作成時のマスターパスワード" PasswordRevealMode="Peek" />
        <TextBlock Style="{StaticResource Caption}" Text="インポート後は、このパスワードでアンロックします。" />
        <TextBlock
            x:Name="ErrorText"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
