<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="KagiBox.Features.Update.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="アップデートがあります"
    CloseButtonText="しない"
    DefaultButton="Primary"
    PrimaryButtonClick="Update_Click"
    PrimaryButtonText="アップデートする"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel MinWidth="440" Spacing="12">
        <TextBlock x:Name="VersionText" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <ScrollViewer x:Name="NotesScroll" MaxHeight="220" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="NotesText" IsTextSelectionEnabled="True" Style="{StaticResource Caption}" />
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <ProgressRing x:Name="Busy" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Text="「アップデートする」を押すと、ダウンロードとインストールを自動で行い、KagiBox を再起動します。" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
