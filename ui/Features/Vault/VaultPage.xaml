<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KagiBox.Features.Vault.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:KagiBox.Core"
    xmlns:local="using:KagiBox.Features.Vault"
    Background="Transparent">

    <Grid Padding="28,20,28,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource PageTitle}" Text="ログイン情報" />
            <TextBlock x:Name="CountText" Grid.Column="1" Margin="0,0,0,4" VerticalAlignment="Bottom" Style="{StaticResource Caption}" />
            <Button Grid.Column="2" Click="Add_Click" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Ctrl+N">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="追加" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            PlaceholderText="サービス名・ID・URL・カテゴリで検索（Ctrl+F）"
            PreviewKeyDown="SearchBox_PreviewKeyDown"
            TextChanged="SearchBox_TextChanged">
            <TextBox.Resources>
                <CornerRadius x:Key="ControlCornerRadius">16</CornerRadius>
            </TextBox.Resources>
        </TextBox>

        <StackPanel x:Name="Chips" Grid.Row="2" Orientation="Horizontal" Spacing="8" />

        <TextBlock x:Name="HintText" Grid.Row="3" Style="{StaticResource Caption}">
            <Run Text="Enter: 選択中（先頭）のパスワードをコピー" />
            <Run Text="   Shift+Enter: ID をコピー" />
            <Run Text="   ↑↓: 選択" />
            <Run Text="   クリック / F2: 編集" />
            <Run Text="   右クリック: その他の操作" />
        </TextBlock>

        <Grid Grid.Row="4">
            <ListView
                x:Name="List"
                Padding="0,0,0,24"
                IsItemClickEnabled="True"
                ItemClick="List_ItemClick"
                PreviewKeyDown="List_PreviewKeyDown"
                RightTapped="List_RightTapped"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AccountItem">
                        <Border Padding="14,10" Style="{StaticResource FluentCard}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="40" Height="40">
                                    <Ellipse Fill="{ThemeResource AvatarBrush}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Initial}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <Border
                                            Padding="8,1"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="8"
                                            Visibility="{x:Bind HasCategory}">
                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Category}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="{x:Bind DisplayUser}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Click="CopyUser_Click"
                                    IsEnabled="{x:Bind HasUsername}"
                                    Opacity="{x:Bind core:Ui.Opacity(HasUsername)}"
                                    ToolTipService.ToolTip="ID / メールアドレスをコピー">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Glyph="&#xE77B;" />
                                        <TextBlock Text="ID" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Click="CopyPassword_Click"
                                    IsEnabled="{x:Bind HasPassword}"
                                    Opacity="{x:Bind core:Ui.Opacity(HasPassword)}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="パスワードをコピー">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                                        <TextBlock Text="パスワード" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="4"
                                    Width="36"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OpenUrl_Click"
                                    IsEnabled="{x:Bind HasUrl}"
                                    Opacity="{x:Bind core:Ui.Opacity(HasUrl)}"
                                    ToolTipService.ToolTip="ログインページを開く">
                                    <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                                </Button>
                                <Button
                                    Grid.Column="5"
                                    Width="36"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="Favorite_Click"
                                    ToolTipService.ToolTip="{x:Bind FavoriteTip}">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Glyph="{x:Bind FavoriteGlyph}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                x:Name="EmptyState"
                MaxWidth="480"
                Margin="0,24,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Style="{StaticResource FluentCard}"
                Visibility="Collapsed">
                <StackPanel Padding="8,12" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8D7;" />
                    <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="EmptyBody" HorizontalAlignment="Center" Style="{StaticResource Caption}" TextAlignment="Center" />
                    <Button
                        x:Name="EmptyAddButton"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        Click="Add_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="最初のアカウントを追加" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
