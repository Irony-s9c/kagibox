<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="KagiBox.Features.Vault.AccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="キャンセル"
    DefaultButton="Primary"
    PrimaryButtonClick="Save_Click"
    PrimaryButtonText="保存"
    SecondaryButtonClick="Delete_Click"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer MinWidth="460" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Padding="0,0,12,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ServiceBox" Header="サービス名（必須）" PlaceholderText="例: Google、Amazon" />
                <AutoSuggestBox
                    x:Name="CategoryBox"
                    Grid.Column="1"
                    Header="カテゴリ"
                    PlaceholderText="例: 仕事 / 個人"
                    TextChanged="CategoryBox_TextChanged" />
            </Grid>

            <TextBox
                x:Name="UrlBox"
                Header="ログインページの URL"
                LostFocus="UrlBox_LostFocus"
                PlaceholderText="例: https://accounts.google.com" />
            <TextBox x:Name="UserBox" Header="ID / メールアドレス" />

            <StackPanel Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Plain text so the stored password can be checked at a glance while editing. -->
                    <TextBox
                        x:Name="PasswordBox"
                        FontFamily="{StaticResource KagiMonoFont}"
                        Header="パスワード"
                        IsSpellCheckEnabled="False"
                        TextChanged="PasswordBox_TextChanged" />
                    <Button
                        Grid.Column="1"
                        Height="32"
                        VerticalAlignment="Bottom"
                        Click="Generate_Click"
                        ToolTipService.ToolTip="強いパスワードを自動生成（設定は「パスワード生成」画面と共通）">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="13" Glyph="&#xE945;" />
                            <TextBlock Text="生成" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="StrengthBar" VerticalAlignment="Center" Maximum="3" Value="0" />
                    <TextBlock x:Name="StrengthText" Grid.Column="1" MinWidth="64" Style="{StaticResource Caption}" />
                </Grid>
            </StackPanel>

            <CheckBox x:Name="FavoriteBox" Content="お気に入り（一覧の上に表示）" />

            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!-- Delete confirmation (a second ContentDialog cannot open on top of this one). -->
            <Border
                x:Name="DeleteConfirm"
                Padding="14,12"
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="DeleteConfirmText" TextWrapping="Wrap" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button Click="DeleteCancel_Click" Content="やめる" />
                        <Button Click="DeleteConfirm_Click" Background="{ThemeResource SystemFillColorCriticalBrush}" Foreground="White">
                            <TextBlock Text="削除する" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
