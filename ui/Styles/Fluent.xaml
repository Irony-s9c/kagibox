<?xml version="1.0" encoding="utf-8"?>
<!--
  Fluent Design System layers (Mica / acrylic) on top of the window:
    back   : window (Mica Alt, darkest / most blurred) and the navigation pane
    middle : cards (FluentCard: translucent fill + thin light rim + slight sheen on top)
    front  : dialogs, flyouts, menus (WinUI's own acrylic, brighter and less blurred)
  Colors stay neutral; the only accent is the calm blue below.
  When Windows' transparency effects are off, App.xaml.cs swaps the card brushes
  for the opaque *Solid variants so text stays readable.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#2F5FC4</Color>
            <Color x:Key="SystemAccentColorLight1">#3F70D3</Color>
            <Color x:Key="SystemAccentColorLight2">#5A86DD</Color>
            <Color x:Key="SystemAccentColorDark1">#2852A9</Color>
            <Color x:Key="SystemAccentColorDark2">#21458E</Color>
            <LinearGradientBrush x:Key="FluentRimBrush" StartPoint="0,0" EndPoint="0.6,1">
                <GradientStop Offset="0" Color="#E6FFFFFF" />
                <GradientStop Offset="0.45" Color="#40FFFFFF" />
                <GradientStop Offset="1" Color="#14000000" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="FluentSheenBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#40FFFFFF" />
                <GradientStop Offset="0.35" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="FluentCardBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="FluentCardSolidBrush" Color="#FFF9F9F9" />
            <SolidColorBrush x:Key="FluentPaneBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="FluentPaneSolidBrush" Color="#FFEDEDED" />
            <SolidColorBrush x:Key="AvatarBrush" Color="#1F2F5FC4" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#6E95E6</Color>
            <Color x:Key="SystemAccentColorLight1">#83A5EB</Color>
            <Color x:Key="SystemAccentColorLight2">#9DB8F0</Color>
            <Color x:Key="SystemAccentColorDark1">#5A84DD</Color>
            <Color x:Key="SystemAccentColorDark2">#3F70D3</Color>
            <LinearGradientBrush x:Key="FluentRimBrush" StartPoint="0,0" EndPoint="0.6,1">
                <GradientStop Offset="0" Color="#4DFFFFFF" />
                <GradientStop Offset="0.45" Color="#14FFFFFF" />
                <GradientStop Offset="1" Color="#33000000" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="FluentSheenBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#14FFFFFF" />
                <GradientStop Offset="0.35" Color="#00FFFFFF" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="FluentCardBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="FluentCardSolidBrush" Color="#FF2B2B2B" />
            <SolidColorBrush x:Key="FluentPaneBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="FluentPaneSolidBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="AvatarBrush" Color="#336E95E6" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="FluentRimBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FluentSheenBrush" Color="Transparent" />
            <SolidColorBrush x:Key="FluentCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FluentCardSolidBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FluentPaneBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FluentPaneSolidBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AvatarBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Japanese UI font: Yu Gothic UI, then Meiryo UI. -->
    <FontFamily x:Key="ContentControlThemeFontFamily">Yu Gothic UI, Meiryo UI, Segoe UI</FontFamily>
    <FontFamily x:Key="KagiMonoFont">Cascadia Mono, Consolas</FontFamily>

    <CornerRadius x:Key="FluentCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>

    <!-- Middle layer: a glass card. Put content inside; padding is included. -->
    <Style x:Key="FluentCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FluentCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FluentRimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FluentCornerRadius}" />
        <Setter Property="Padding" Value="20,16" />
    </Style>

    <!-- The faint sheen on the upper part of a glass surface. Place as the first child of a Grid inside a card. -->
    <Style x:Key="FluentSheen" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FluentSheenBrush}" />
        <Setter Property="CornerRadius" Value="11,11,0,0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
