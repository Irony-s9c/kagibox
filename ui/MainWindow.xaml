<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KagiBox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lock="using:KagiBox.Features.Lock"
    Title="KagiBox">

    <!-- Back layer: Mica Alt (darker, stronger blur than Base) behind everything. -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="LockAccelerator_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="AddAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Title bar (drawn by the app on top of Mica) -->
        <Grid x:Name="TitleBar" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="18" Height="18" VerticalAlignment="Center" Source="ms-appx:///Assets/KagiBox.ico" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="KagiBox" />
            <StackPanel
                x:Name="LockState"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="Collapsed">
                <FontIcon FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE785;" />
                <TextBlock Style="{StaticResource Caption}" Text="アンロック中" />
            </StackPanel>
        </Grid>

        <!-- Locked: the lock / first-run card -->
        <lock:LockView x:Name="LockView" Grid.Row="1" Unlocked="LockView_Unlocked" />

        <!-- Unlocked: navigation + pages -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            OpenPaneLength="240"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged"
            Visibility="Collapsed">
            <NavigationView.Resources>
                <!-- The pane is part of the back layer: let the window's Mica show through. -->
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentMargin">0,0,0,0</Thickness>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="VaultItem" Content="ログイン情報" Tag="vault">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="CountBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="パスワード生成" Tag="generator">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="セキュリティ診断" Tag="health">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA18;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <Button
                    Margin="12,4,12,8"
                    HorizontalAlignment="Stretch"
                    Click="LockNow_Click"
                    ToolTipService.ToolTip="Ctrl+L">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72E;" />
                        <TextBlock Text="今すぐロック" />
                    </StackPanel>
                </Button>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Notifications, newest at the bottom -->
        <StackPanel
            x:Name="Toasts"
            Grid.Row="1"
            Width="400"
            Margin="0,0,20,20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Spacing="8">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="16" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
        </StackPanel>

        <!-- Shown until the core reports "ready" -->
        <Grid x:Name="StartupOverlay" Grid.RowSpan="2" Background="Transparent">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="起動しています" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
