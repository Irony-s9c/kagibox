# Copy this file to ".env" (next to the exe, or in the project root when running from source).
# Never commit the real .env file. All values are empty on purpose.

# Release repository that hosts only the release .exe files ("owner/repo").
GITHUB_REPO=

# Optional. Only for a private release repository. Fine-grained token, Contents: Read-only.
GITHUB_TOKEN=

# Set to false to disable the automatic update check on startup.
UPDATE_CHECK_ENABLED=true
